# =============================================================================
# Copy this to  ~/ministore/.env  on the server and fill in real values.
# NEVER commit the filled-in .env (it holds secrets). Only .env.example is safe.
# =============================================================================

# ---- Your domain (register one; point app/api/auth subdomains at the EC2 IP) -
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com          # for Let's Encrypt / Caddy certificates

# ---- Database (Postgres runs in a container) --------------------------------
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password

# ---- Shared JWT secret (auth signs, product/order verify — must match) ------
# Generate one:  openssl rand -base64 48
MINISTORE_JWT_SECRET=change-me-long-random-hmac-secret

# ---- Google OAuth2 (from Google Cloud Console) ------------------------------
# Add redirect URI:  https://auth.<DOMAIN>/login/oauth2/code/google
AUTH_GOOGLE_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxx

# ---- Stripe (LIVE keys for production; test keys to trial first) ------------
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
