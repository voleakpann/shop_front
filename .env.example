# Copy this to .env.local and fill in your Google OAuth credentials.
# Do NOT commit .env.local to git — it contains secrets.

# NextAuth session secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here

# Google OAuth2 (from https://console.cloud.google.com/)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Stripe (optional for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend URLs (use these for local docker-compose development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:8081
